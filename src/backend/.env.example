# Free key from Google AI Studio. Without it, outfits use the built-in rules only.
GEMINI_API_KEY=

# Postgres connection from Neon (neon.com). Create the tables with: npm run db:setup
DATABASE_URL=
# Direct, unpooled address, used for setting up tables and backups
DATABASE_URL_UNPOOLED=

# "Forgot password" emails through Resend (resend.com). Without a key the email
# is printed in the backend terminal instead, fine for testing.
RESEND_API_KEY=
# Sender, for example "StyleAI <hello@yourdomain.com>". Needs a domain verified in Resend.
MAIL_FROM=
# The app's address, used in the reset link. Defaults to http://127.0.0.1:5173
APP_URL=
